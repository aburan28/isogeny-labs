# Load using your process manager, or node --env-file=.env server/index.mjs.
DATABASE_URL=postgres://user:password@localhost:5432/isogeny
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Set during the frontend build; omit to ship the disabled contact state.
CONTACT_API_URL=/api/inquiries
# TRUST_PROXY is intentionally unset: only add your known reverse-proxy CIDRs.
# TRUST_PROXY=10.0.0.0/24
PORT=3000
